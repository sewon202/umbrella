rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isDevice() {
      return signedIn() && request.auth.token.email == 'device@umbrella.local';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isStudent() {
      return signedIn() && !isDevice();
    }
    function validSlot(slot) {
      return slot is int && slot >= 1 && slot <= 2;
    }
    function validCommandAction(action) {
      return action in ['open', 'open_return', 'sense_ir', 'sense_rfid', 'test_open', 'test_close'];
    }
    function deviceTestAction(action) {
      return action in ['test_open', 'test_close'];
    }
    function validPayCard(card) {
      return card.keys().hasOnly(['id', 'issuer', 'nickname', 'brand', 'number', 'expiry', 'cvc', 'pw2', 'last4', 'registeredAt'])
        && card.id is string
        && card.id.size() > 0
        && card.id.size() <= 40
        && card.issuer is string
        && card.issuer.matches('^(신한카드|삼성카드|현대카드|KB국민카드|롯데카드|우리카드|하나카드|NH농협카드|BC카드|씨티카드|카카오뱅크|토스뱅크|케이뱅크|IBK기업은행|수협은행|새마을금고|우체국|광주은행|전북은행|제주은행)$')
        && card.nickname is string
        && card.nickname.size() <= 20
        && card.brand == card.issuer
        && card.number is string
        && card.number.matches('^[0-9]{16}$')
        && card.expiry is string
        && card.expiry.matches('^(0[1-9]|1[0-2])[0-9][0-9]$')
        && card.cvc is string
        && card.cvc.matches('^[0-9]{3,4}$')
        && card.pw2 is string
        && card.pw2.matches('^[0-9]{2}$')
        && card.last4 is string
        && card.last4.matches('^[0-9]{4}$')
        && card.registeredAt is int;
    }
    function validPayList(cards) {
      return cards is list
        && cards.size() <= 5
        && (cards.size() < 1 || validPayCard(cards[0]))
        && (cards.size() < 2 || validPayCard(cards[1]))
        && (cards.size() < 3 || validPayCard(cards[2]))
        && (cards.size() < 4 || validPayCard(cards[3]))
        && (cards.size() < 5 || validPayCard(cards[4]));
    }
    function payWalletOk() {
      return validPayList(request.resource.data.paymentMethods)
        && request.resource.data.defaultPaymentId is string
        && (
          (request.resource.data.paymentMethods.size() == 0
            && request.resource.data.defaultPaymentId == ''
            && request.resource.data.paymentMethod == null)
          || (request.resource.data.paymentMethods.size() > 0
            && validPayCard(request.resource.data.paymentMethod)
            && defaultIsListed())
        );
    }
    function defaultIsListed() {
      return request.resource.data.defaultPaymentId == request.resource.data.paymentMethod.id
        && (
          request.resource.data.paymentMethods[0].id == request.resource.data.defaultPaymentId
          || (request.resource.data.paymentMethods.size() > 1 && request.resource.data.paymentMethods[1].id == request.resource.data.defaultPaymentId)
          || (request.resource.data.paymentMethods.size() > 2 && request.resource.data.paymentMethods[2].id == request.resource.data.defaultPaymentId)
          || (request.resource.data.paymentMethods.size() > 3 && request.resource.data.paymentMethods[3].id == request.resource.data.defaultPaymentId)
          || (request.resource.data.paymentMethods.size() > 4 && request.resource.data.paymentMethods[4].id == request.resource.data.defaultPaymentId)
        );
    }

    // 사용자 프로필 — 본인 또는 device(관리)만
    match /students/{uid} {
      allow read: if isOwner(uid) || isDevice();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['studentId', 'name', 'created_at'])
        && request.resource.data.keys().hasOnly(['studentId', 'name', 'created_at', 'activeRental', 'lmsVerified', 'lmsVerifiedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.name is string
        && request.resource.data.activeRental == null
        && (!('lmsVerified' in request.resource.data) || request.resource.data.lmsVerified == false)
        && (!('lmsVerifiedAt' in request.resource.data) || request.resource.data.lmsVerifiedAt == null);
      allow update: if isDevice()
        || (isOwner(uid)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activeRental', 'updated_at', 'name', 'paymentMethod', 'paymentMethods', 'defaultPaymentId'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethod', 'paymentMethods', 'defaultPaymentId'])
            || (
              validPayList(request.resource.data.paymentMethods)
              && payWalletOk()
            )
          ));
    }

    // 우산 슬롯 — 학생은 대여(in→out)·반납(out→in)만, 생성/기타는 device
    match /umbrellas/{id} {
      allow read: if signedIn();
      allow create: if isDevice();
      allow update: if isDevice()
        || (isStudent()
          && request.resource.data.station == resource.data.station
          && request.resource.data.slot == resource.data.slot
          && (
            (resource.data.status == 'in' && request.resource.data.status == 'out'
              && request.resource.data.rented_by is string)
            ||
            (resource.data.status == 'out' && request.resource.data.status == 'in'
              && request.resource.data.rented_by == null)
          ));
    }

    // 대여 기록 — 본인 생성/반납, 목록 조회는 device(관리)
    match /rentals/{id} {
      allow read: if isDevice()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.returned_at == null
        && validSlot(request.resource.data.slot);
      allow update: if isDevice()
        || (isStudent()
          && resource.data.studentUid == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.status == 'returned'
          && request.resource.data.studentUid == resource.data.studentUid);
    }

    // 문 열기 명령 — 학생/device 생성, 읽기·완료 처리는 device만
    match /commands/{id} {
      allow read: if isDevice();
      allow create: if signedIn()
        && request.resource.data.station is string
        && validSlot(request.resource.data.slot)
        && validCommandAction(request.resource.data.action)
        && request.resource.data.done == 0
        && request.resource.data.done_at == null
        && (!deviceTestAction(request.resource.data.action) || isDevice());
      allow update: if isDevice()
        && request.resource.data.done == 1
        && resource.data.done == 0;
    }

    // 보드 이벤트 — 기록은 device만, 앱 애니메이션용 읽기는 로그인 사용자
    match /device_events/{id} {
      allow read: if signedIn();
      allow create: if isDevice()
        && request.resource.data.station is string
        && request.resource.data.kind is string
        && request.resource.data.created_at is int;
      allow update, delete: if false;
    }

    // 거점 메타/하트비트 — 공개 읽기, 쓰기는 device만
    match /stations/{id} {
      allow read: if true;
      allow create, update: if isDevice();
      allow delete: if false;
    }
  }
}
